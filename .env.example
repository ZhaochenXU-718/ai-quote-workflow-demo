# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
#   cp .env.example .env
# Only DEEPSEEK_API_KEY is required to use the real DeepSeek provider; everything
# else has sensible defaults in backend/app/p5/model_gateway.py.

# Secret — never commit the real value.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides (defaults shown):
# LLM_PROVIDER=mock                  # set to "deepseek" to use the real API
# LLM_MODEL=deepseek-v4-flash
# LLM_FALLBACK_MODEL=deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MAX_TOKENS=1024                # must leave room for reasoning_content
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=60
# LLM_API_KEY=                       # alternative to DEEPSEEK_API_KEY (takes precedence)
